# Copy to .env. Never send these values in Telegram or commit them.
OPENAI_API_KEY=
# Set a model available to your API project, supporting Responses + structured outputs + images.
OPENAI_MODEL=gpt-6-sol
REASONING_EFFORT=medium
TRANSCRIPTION_MODEL=gpt-4o-transcribe
MAX_AUDIO_SECONDS=300
TELEGRAM_BOT_TOKEN=
DATABASE_URL=postgresql://zan:change-local-password@localhost:5432/zan
POSTGRES_PASSWORD=change-local-password
API_SECRET=replace-with-at-least-32-random-characters
SESSION_SECRET=replace-with-another-32-random-characters
# Generate locally: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
ADMIN_SECRET=replace-with-a-separate-32-character-secret
ENABLE_SEMANTIC_SEARCH=true
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=512
VERIFY_ANSWERS=true
DAILY_REQUEST_LIMIT=30
MAX_CONCURRENT_REQUESTS=4
MAX_QUEUE_JOBS=200
ENABLE_WEB_SEARCH=false
CONSULTATION_URL=
SESSION_TTL_SECONDS=1800
MAX_FILE_BYTES=10485760
MAX_INPUT_CHARS=24000
